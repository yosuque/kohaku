{
  "name": "@kohaku-ui/sandbox",
  "version": "0.1.0",
  "description": "Isolated execution for kohaku's free-form (L2) output: opaque iframe, restrictive CSP and an allowlisted bridge.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.tsx",
    "./smoke": "./src/smoke/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@kohaku-ui/renderer-core": "workspace:^",
    "@kohaku-ui/spec-core": "workspace:^"
  },
  "peerDependencies": {
    "jsdom": "catalog:",
    "react": "^19.0.0",
    "zod": "catalog:"
  },
  "peerDependenciesMeta": {
    "jsdom": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@kohaku-ui/composer": "workspace:^",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/yosuque/kohaku/tree/main/packages/sandbox#readme",
  "bugs": {
    "url": "https://github.com/yosuque/kohaku/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yosuque/kohaku.git",
    "directory": "packages/sandbox"
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./react": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "./smoke": {
        "types": "./dist/smoke/index.d.ts",
        "default": "./dist/smoke/index.js"
      },
      "./package.json": "./package.json"
    }
  }
}
