{
  "name": "@kohaku-ui/host-core",
  "version": "0.5.0",
  "description": "Framework-free shared host core for kohaku: fixation delivery and self-healing, capability issuance, intent resolution and fail-open observability helpers.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./policy-node": "./src/policy-node.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@kohaku-ui/spec-core": "workspace:^",
    "@kohaku-ui/composer": "workspace:^",
    "@kohaku-ui/llm": "workspace:^",
    "@kohaku-ui/data-binding": "workspace:^",
    "@kohaku-ui/registry": "workspace:^"
  },
  "peerDependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@kohaku-ui/port-contracts": "workspace:^",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/yosuque/kohaku/tree/main/packages/host-core#readme",
  "bugs": {
    "url": "https://github.com/yosuque/kohaku/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yosuque/kohaku.git",
    "directory": "packages/host-core"
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./policy-node": {
        "types": "./dist/policy-node.d.ts",
        "default": "./dist/policy-node.js"
      },
      "./package.json": "./package.json"
    }
  }
}
