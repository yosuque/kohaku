{
  "name": "@kohaku-ui/domain-mcp",
  "version": "0.5.0",
  "description": "Turns an existing MCP server into a kohaku DomainPort: read-only tools become query:// references, every other tool becomes an approve-tier governed Action.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@kohaku-ui/data-binding": "workspace:^",
    "@kohaku-ui/intents": "workspace:^",
    "@kohaku-ui/spec-core": "workspace:^"
  },
  "peerDependencies": {
    "@modelcontextprotocol/client": "catalog:",
    "zod": "catalog:"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@kohaku-ui/authz-hmac": "workspace:^",
    "@kohaku-ui/host": "workspace:^",
    "@kohaku-ui/llm": "workspace:^",
    "@modelcontextprotocol/client": "catalog:",
    "@modelcontextprotocol/server": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/yosuque/kohaku/tree/main/packages/domain-mcp#readme",
  "bugs": {
    "url": "https://github.com/yosuque/kohaku/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yosuque/kohaku.git",
    "directory": "packages/domain-mcp"
  },
  "engines": {
    "node": ">=24.22.1"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  }
}
