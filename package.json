{
  "name": "kohaku-monorepo",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yosuque/kohaku.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22",
    "pnpm": ">=12"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present run typecheck",
    "build": "pnpm -r --if-present run build",
    "build:dist": "pnpm --filter \"./packages/*\" --filter ./cli --filter ./spec run build",
    "meta:sync": "tsx scripts/sync-package-meta.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "seed": "pnpm --filter @kohaku-ui-sample/api run seed",
    "smoke:pack": "node scripts/pack-smoke.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "intents:emit": "pnpm --filter @kohaku-ui-sample/api run intents:emit",
    "dev": "pnpm -r --parallel --filter @kohaku-ui-sample/api --filter @kohaku-ui-sample/web run dev",
    "docs:dev": "pnpm --filter @kohaku-ui-docs/site dev",
    "docs:build": "pnpm --filter @kohaku-ui-docs/site build",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check --write .",
    "check:ci": "biome ci --error-on-warnings .",
    "changeset": "changeset",
    "version": "changeset version && pnpm run meta:sync && tsx scripts/sync-python-version.ts && pnpm install --lockfile-only",
    "release": "pnpm run build:dist && pnpm -r publish --no-git-checks",
    "python:version": "tsx scripts/sync-python-version.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "2.5.14",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "publint": "^0.3.24",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
