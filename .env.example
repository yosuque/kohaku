# ===== LLM provider configuration (optional: L0 works without a key; L1/L2 generation needs one) =====
# claude | openai | gemini | ollama | llama
KOHAKU_LLM_PROVIDER=claude

# Specify to override the per-provider default model
#   claude: claude-sonnet-4-6 / openai: gpt-4.1 / gemini: gemini-2.5-flash
#   ollama: llama3.3 / llama: required (OpenAI-compatible, e.g. llama.cpp server)
# Note: for ollama a non-thinking model (e.g. gemma family) is recommended. Thinking models
#       consume the token budget on reasoning, making L1 generation slow or empty.
# KOHAKU_LLM_MODEL=

# API key (KOHAKU_LLM_API_KEY takes precedence; otherwise the provider's standard env var is used)
# KOHAKU_LLM_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# OpenAI-compatible endpoint (ollama default: http://localhost:11434/v1; required for llama)
# KOHAKU_LLM_BASE_URL=

# Generation parameters (default: temperature 0)
# KOHAKU_LLM_TEMPERATURE=0
# KOHAKU_LLM_MAX_OUTPUT_TOKENS=4096

# Structured-output mode: auto (default: native, falling back to prompt JSON on failure) | strict | prompt
# KOHAKU_LLM_STRUCTURED_MODE=auto

# Timeout for a single LLM call (milliseconds; default 60000)
# KOHAKU_LLM_TIMEOUT_MS=60000

# Retry policy for transient PROVIDER failures (429/5xx). 0 disables retries. Never exceeds KOHAKU_LLM_TIMEOUT_MS overall.
# KOHAKU_LLM_RETRY_MAX=2
# KOHAKU_LLM_RETRY_INITIAL_MS=250

# Opt-in Anthropic prompt caching (claude provider only; no-op for every other provider). Marks the
# byte-stable prefix of the L1/L2 prompt with cache_control so a same-compose repair retry can reuse it.
# See docs/user-guide.md §7 "Operational tips" ("Measure before touching prompt caching or
# refConstraint") for the per-model minimum prefix length below which this has no effect.
# KOHAKU_LLM_PROMPT_CACHE=0

# ===== Sample app =====
# HMAC signing secret for capability tokens (for the demo; always change in production)
KOHAKU_CAPABILITY_SECRET=dev-secret-change-me

# sample-api port (default 8787)
# PORT=8787

# Graceful-shutdown drain window (milliseconds) for the TS samples (sample-api / sample-mcp) on SIGINT/SIGTERM
# KOHAKU_SHUTDOWN_GRACE_MS=30000

# Extra wait (milliseconds) between marking sample-api not-ready and actually closing the server on
# SIGINT/SIGTERM (default 0). Set this to your load balancer's health-check interval (or a bit more) so it is
# guaranteed to observe at least one 503 from GET /api/health before the port stops accepting connections.
# KOHAKU_SHUTDOWN_PRESTOP_MS=0

# Base URL sample-web / sample-wc's Vite dev server proxies /api requests to (default: http://localhost:${PORT
# ?? 8787}). Set this if sample-api runs on a non-default host/port and PORT alone does not cover it.
# KOHAKU_API_URL=http://localhost:8787

# sample-api (TS) only: 1 combines an OpenTelemetry compose observer (@kohaku-ui/otel) with the demo's
# console observer. Ships no exporter/SDK initialization of its own — see docs/user-guide.md's
# "Trace context / OTel" section for the bootstrap steps needed to see spans.
# KOHAKU_OTEL=0

# Compose-wide deadline (milliseconds) fed into ComposePolicy.budget.deadlineMs (a safety valve, not a
# cost cap): bounds one whole compose/composeStream call (L1 through repair through L2) and downgrades to
# the deterministic fallback on expiry. Default 240000 (one straight-to-L2 run's ~180s L2 timeout plus
# headroom for a repair retry). Mirrored by the Python sample.
# KOHAKU_COMPOSE_DEADLINE_MS=240000

# ===== sample-mcp (Streamable HTTP entry, src/http.ts) =====
# Listen port (default 8788)
# KOHAKU_MCP_HTTP_PORT=8788

# Bind address (default 127.0.0.1 = local only; widen only when needed, e.g. 0.0.0.0 for LAN/container exposure)
# KOHAKU_MCP_HTTP_HOST=127.0.0.1

# Comma-separated allowed hosts for DNS-rebinding protection (disabled unless set), e.g. localhost:8788,127.0.0.1:8788
# KOHAKU_MCP_HTTP_ALLOWED_HOSTS=

# Base URL for static snapshot serving (/snapshots); set the tunnel URL when exposing via ngrok/cloudflared etc.
# KOHAKU_MCP_PUBLIC_URL=http://localhost:8788

# mcp-ui legacy host compatibility: append a self-contained snapshot HTML to compose-family tool results
# KOHAKU_MCP_LEGACY_UI=1

# TTL (milliseconds) for the periodic cleanup of snapshot HTML files under .data/snapshots (default 24h;
# each self-contained snapshot is ~1MB and previously accumulated without bound)
# KOHAKU_MCP_SNAPSHOT_TTL_MS=86400000
