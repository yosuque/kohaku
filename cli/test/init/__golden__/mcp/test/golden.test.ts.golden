/**
 * Golden Spec regression (generated by kohaku init). Pins the structure of Intent → Spec; LLM output jitter
 * (provenance / hashes / component ids) is normalized away by runGolden. No LLM is used: fixtures for L1 views
 * carry the model's raw drafts (FakeLlm), the L0 summary fixture needs none.
 *
 * Generating / updating `expected`: KOHAKU_GOLDEN_UPDATE=1 npm test writes each fixture's expected back from the actual
 * compose output (deterministic, no LLM); review the diff and commit. A fixture whose expected is still null fails
 * until you do that. Never run update mode in CI.
 */
import { existsSync, readdirSync, readFileSync, writeFileSync } from "node:fs";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";
import { type ComposeContext, type ComposeInput, compose } from "@kohaku-ui/composer";
import { type GoldenCase, runGolden } from "@kohaku-ui/evals";
import { FakeLlm } from "@kohaku-ui/llm/fake";
import type { UISpec } from "@kohaku-ui/spec-core";
import { describe, expect, it } from "vitest";
import { createApp } from "../server/app.js";

const GOLDEN_DIR = join(dirname(fileURLToPath(import.meta.url)), "golden");
const UPDATE = process.env["KOHAKU_GOLDEN_UPDATE"] === "1";
if (UPDATE && process.env["CI"] != null) {
  throw new Error("KOHAKU_GOLDEN_UPDATE=1 must not run in CI (it rewrites goldens instead of asserting them)");
}

interface GoldenFixture {
  name: string;
  input: ComposeInput;
  drafts: unknown[];
  expected: UISpec | null;
}

function makeContext(drafts: unknown[]): ComposeContext {
  return createApp({ llm: new FakeLlm({ objects: drafts }) }).composeCtx;
}

const files = existsSync(GOLDEN_DIR) ? readdirSync(GOLDEN_DIR).filter((f) => f.endsWith(".json")).sort() : [];

describe("golden regression", () => {
  for (const file of files) {
    const path = join(GOLDEN_DIR, file);
    const fixture = JSON.parse(readFileSync(path, "utf8")) as GoldenFixture;
    it(fixture.name, async () => {
      const ctx = makeContext(fixture.drafts);
      if (UPDATE) {
        const { spec } = await compose(fixture.input, ctx);
        writeFileSync(path, `${JSON.stringify({ ...fixture, expected: spec }, null, 2)}\n`);
        return;
      }
      expect(fixture.expected, `${file}: expected is null. kohaku init normally generates it after npm install; run KOHAKU_GOLDEN_UPDATE=1 npm test once, review the diff, and commit.`).not.toBeNull();
      const cases: GoldenCase[] = [{ name: fixture.name, input: fixture.input, expected: fixture.expected! }];
      const report = await runGolden(cases, ctx);
      const failed = report.cases.find((c) => !c.pass);
      expect(report.pass, failed ? `golden mismatch (${file})\n${failed.expected}\n---\n${failed.actual}` : undefined).toBe(true);
    });
  }
});
